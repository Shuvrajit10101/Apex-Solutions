<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>   <!-- LOAD-BEARING: corpus code uses .First() with no using System.Linq -->
    <Nullable>enable</Nullable>
    <AssemblyName>OracleRunner</AssemblyName>
    <RootNamespace>HeadOracle</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <ApexLedgerProject Condition="'$(ApexLedgerProject)' == ''">$(MSBuildThisFileDirectory)../src/Apex.Ledger/Apex.Ledger.csproj</ApexLedgerProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ApexLedgerProject)" />
  </ItemGroup>
</Project>
